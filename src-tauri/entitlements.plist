<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ADR-0085, AC-1427: the bundled cartograph-agent sidecar is a Node
	     executable whose V8 JIT needs MAP_JIT under the hardened runtime.
	     Tauri signs every bundled executable with this one file. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
